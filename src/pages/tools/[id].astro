---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ToolPreview from '../../components/ToolPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
    return tools.map((tool, index) => ({
        params: { id: tool.id },
        props: {
            tool,
            prevTool: index + 1 !== tools.length ? tools[index + 1] : null,
            nextTool: index !== 0 ? tools[index - 1] : null
        }
    }));
}

type Props = {
    tool: CollectionEntry<'tools'>;
    prevTool: CollectionEntry<'tools'>;
    nextTool: CollectionEntry<'tools'>;
};

const { tool, prevTool, nextTool } = Astro.props;
const { title, description, seo } = tool.data;
const { Content } = await render(tool);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>
    {
        (prevTool || nextTool) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">View Next Tool</h2>
                {nextTool && <ToolPreview tool={nextTool} class="mb-10 sm:mb-12" headingLevel="h3" />}
                {prevTool && <ToolPreview tool={prevTool} class="mb-10 sm:mb-12" headingLevel="h3" />}
            </div>
        )
    }
</BaseLayout>
